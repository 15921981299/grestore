---
import type { GreVocabEntry } from '@/lib/gre';

interface Props {
  entries: GreVocabEntry[];
}

const { entries } = Astro.props;
---

<section class="vocab gre-card">
  <div class="vocab__head-block">
    <h2 class="gre-section-title">难词注释</h2>
    <p class="vocab__count">{entries.length} 词</p>
  </div>
  <dl class="vocab__list">
    {
      entries.map((entry) => (
        <div class="vocab__item">
          <dt class="vocab__head">
            <div class="vocab__title">
              <span class="vocab__word">{entry.word}</span>
              <button
                type="button"
                class="vocab__speak"
                data-word={entry.word}
                aria-label={`朗读 ${entry.word}`}
                title="朗读单词"
              >
                <span class="vocab__speak-icon" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M11 5L6 9H3v6h3l5 4V5z"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                    <path
                      class="vocab__speak-wave vocab__speak-wave--1"
                      d="M15.5 8.5a5 5 0 0 1 0 7"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"></path>
                    <path
                      class="vocab__speak-wave vocab__speak-wave--2"
                      d="M18 6a8.5 8.5 0 0 1 0 12"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"></path>
                  </svg>
                </span>
                <span class="vocab__speak-label">发音</span>
              </button>
            </div>
            {entry.phonetic && <span class="vocab__phonetic">[{entry.phonetic}]</span>}
          </dt>
          <dd class="vocab__body">
            {entry.lines.map((line) => (
              <p>{line}</p>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<script>
  function speakWord(word: string, button: HTMLButtonElement) {
    if (!('speechSynthesis' in window)) return;

    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(word);
    utterance.lang = 'en-US';
    utterance.rate = 0.92;

    button.classList.add('is-speaking');
    utterance.onend = () => button.classList.remove('is-speaking');
    utterance.onerror = () => button.classList.remove('is-speaking');

    window.speechSynthesis.speak(utterance);
  }

  document.querySelectorAll<HTMLButtonElement>('.vocab__speak').forEach((button) => {
    button.addEventListener('click', () => {
      const word = button.dataset.word?.trim();
      if (!word) return;
      speakWord(word, button);
    });
  });
</script>

<style>
  .vocab__head-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap);
    margin-bottom: var(--space-gap-lg);
  }

  .vocab__head-block .gre-section-title {
    margin-bottom: 0;
  }

  .vocab__count {
    margin: 0;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--gre-muted-light);
  }

  .vocab__list {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .vocab__item {
    margin: 0;
    padding-block: var(--space-gap);
    border-bottom: 1px solid var(--gre-border);
  }

  .vocab__item:first-child {
    padding-top: 0;
  }

  .vocab__item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .vocab__head {
    margin: 0 0 0.375rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .vocab__title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .vocab__word {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--gre-text);
  }

  .vocab__speak {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    height: 1.75rem;
    padding: 0 0.5625rem 0 0.4375rem;
    color: var(--gre-muted);
    background: transparent;
    border: 1px solid var(--gre-border);
    border-radius: 999px;
    cursor: pointer;
    transition:
      color 180ms ease-out,
      background 180ms ease-out,
      border-color 180ms ease-out;
  }

  .vocab__speak-icon {
    display: inline-grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .vocab__speak-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .vocab__speak-wave {
    opacity: 0.45;
    transform-origin: center;
  }

  .vocab__speak:hover {
    color: var(--gre-accent-text);
    background: var(--gre-accent-soft);
    border-color: rgba(15, 118, 110, 0.22);
  }

  .vocab__speak:hover .vocab__speak-wave {
    opacity: 0.75;
  }

  .vocab__speak:focus-visible {
    outline: 2px solid var(--gre-accent);
    outline-offset: 2px;
  }

  .vocab__speak.is-speaking {
    color: var(--gre-accent-text);
    background: var(--gre-accent-soft);
    border-color: rgba(15, 118, 110, 0.35);
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
  }

  .vocab__speak.is-speaking .vocab__speak-wave {
    opacity: 1;
  }

  .vocab__speak.is-speaking .vocab__speak-wave--1 {
    animation: vocab-wave 0.9s ease-in-out infinite;
  }

  .vocab__speak.is-speaking .vocab__speak-wave--2 {
    animation: vocab-wave 0.9s ease-in-out 0.15s infinite;
  }

  @keyframes vocab-wave {
    0%,
    100% {
      opacity: 0.35;
    }

    50% {
      opacity: 1;
    }
  }

  .vocab__phonetic {
    font-size: 0.875rem;
    color: var(--gre-muted);
    font-family: cursive;
  }

  .vocab__body {
    margin: 0;
  }

  .vocab__body p {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #334155;
  }

  .vocab__body p:last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .vocab__speak {
      transition: none;
    }

    .vocab__speak.is-speaking .vocab__speak-wave--1,
    .vocab__speak.is-speaking .vocab__speak-wave--2 {
      animation: none;
      opacity: 1;
    }
  }
</style>
